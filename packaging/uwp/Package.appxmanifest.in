<?xml version="1.0" encoding="utf-8"?>
<!-- GT3 Revisited as a UWP app (Xbox Dev Mode), docs/dev/XBOX.md. Configured by cmake/Uwp.cmake.
     The Publisher must match the subject of the certificate the package is signed with
     (GT3R_UWP_PUBLISHER). Set the app's type to Game in Dev Home on the console: as an App it
     gets a fraction of the GPU and memory. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="GT3Revisited.Xbox" Publisher="@GT3R_UWP_PUBLISHER@" Version="@GT3R_UWP_VERSION@" />

  <Properties>
    <DisplayName>GT3 Revisited</DisplayName>
    <PublisherDisplayName>GT3 Revisited</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 17763 (1809): the FromApp file functions (cmake/patches/sdl-uwp.patch) need 1803. -->
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="GT3 Revisited"
        Description="Gran Turismo 3 A-Spec engine reimplementation (bring your own disc)"
        BackgroundColor="#161926"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#161926" />
        <uap:InitialRotationPreference>
          <uap:Rotation Preference="landscape" />
        </uap:InitialRotationPreference>
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Online battle: the relay server, session codes, and hosting on a LAN. -->
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <!-- The disc image, wherever it is (a USB drive): opened by its path. -->
    <rescap:Capability Name="broadFileSystemAccess" />
  </Capabilities>
</Package>
