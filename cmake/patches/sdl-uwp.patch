+bool SDL_WasapiActivationHandler::WaitForCompletion(Sint32 timeout_ms)
 {
     if (completion_semaphore) {
-        SDL_WaitSemaphore(completion_semaphore);
+        if (!SDL_WaitSemaphoreTimeout(completion_semaphore, timeout_ms)) {
