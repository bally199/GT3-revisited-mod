     }
+    return true;
+}
+
+// ActivateAudioInterfaceAsync, called on the app's UI thread: "for many implementations, an
+// application must call this function from the main UI thread" (Microsoft), and on Xbox a call
+// from SDL's management thread never completes. The UI thread runs it the next time it pumps
+// events; the app must keep pumping while a device opens (SDL_OpenAudioDevice on another thread).
+struct SDL_WasapiActivateCall
+{
+    LPCWSTR devid;
+    IActivateAudioInterfaceCompletionHandler *handler;
+    IActivateAudioInterfaceAsyncOperation *async;
+    HRESULT result;
+    SDL_Semaphore *done;
+};
+
+static HRESULT WINRT_ActivateAudioInterface(LPCWSTR devid, IActivateAudioInterfaceCompletionHandler *handler,
+                                            IActivateAudioInterfaceAsyncOperation **async)
+{
+    CoreDispatcher ^ dispatcher = nullptr;
+    try {
+        dispatcher = CoreApplication::MainView->CoreWindow->Dispatcher;
+    } catch (Platform::Exception ^) {
+        dispatcher = nullptr;
+    }
+    if (!dispatcher || dispatcher->HasThreadAccess) {
+        return ActivateAudioInterfaceAsync(devid, __uuidof(IAudioClient), nullptr, handler, async);
+    }
+    // On the heap: if the UI thread never gets to it, the call may still run after we gave up.
+    SDL_WasapiActivateCall *call = new SDL_WasapiActivateCall{ devid, handler, nullptr, E_FAIL, SDL_CreateSemaphore(0) };
+    if (!call->done) {
+        delete call;
+        return E_OUTOFMEMORY;
+    }
+    handler->AddRef(); // for the call, released when it has run
+    dispatcher->RunAsync(CoreDispatcherPriority::Normal, ref new DispatchedHandler([call]() {
+        call->result = ActivateAudioInterfaceAsync(call->devid, __uuidof(IAudioClient), nullptr, call->handler, &call->async);
+        call->handler->Release();
+        SDL_SignalSemaphore(call->done);
+    }));
+    if (!SDL_WaitSemaphoreTimeout(call->done, 10000)) {
+        SDL_LogWarn(SDL_LOG_CATEGORY_AUDIO, "WASAPI: the UI thread did not run the device activation within 10 s");
+        return HRESULT_FROM_WIN32(ERROR_TIMEOUT); // `call` is left to the dispatched handler
+    }
+    const HRESULT result = call->result;
+    *async = call->async;
+    SDL_DestroySemaphore(call->done);
+    delete call;
+    return result;
 }
 
 HRESULT
