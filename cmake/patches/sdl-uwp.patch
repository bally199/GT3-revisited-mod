-    handler.Get()->WaitForCompletion();  // block here until we have an answer, so this is synchronous to us after all.
+    // Block here until we have an answer, so this is synchronous to us after all; but not
+    // forever (the answer may never come: no audio is better than an app that never starts).
+    if (!handler.Get()->WaitForCompletion(10000)) {
