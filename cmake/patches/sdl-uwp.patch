+/* GT3 Revisited: the plain Win32 calls only reach the app's own folders in a UWP app. The
+   "FromApp" variants (Windows 10 1803+) also reach whatever the app was granted: a file or
+   folder the user picked, or the whole file system with broadFileSystemAccess (a USB drive on
+   an Xbox). Same signatures. Rename and copy keep the plain calls: MoveFileFromAppW cannot
+   replace a file, and those are only used inside the user data folder. */
+#include <fileapifromapp.h>
+#define FindFirstFileExW FindFirstFileExFromAppW
+#define GetFileAttributesExW GetFileAttributesExFromAppW
+#define CreateDirectoryW(p, sa) CreateDirectoryFromAppW(p, sa)
+#define DeleteFileW DeleteFileFromAppW
+#define RemoveDirectoryW RemoveDirectoryFromAppW
+#endif
